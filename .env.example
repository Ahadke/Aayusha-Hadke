# Copy this file to .env and fill in values. Never commit .env.

PORT=3000

# Where contact form mail is delivered
CONTACT_TO_EMAIL=ahadke26@gmail.com

# Gmail SMTP (required for npm start / Node hosting)
# 1. Google Account → Security → 2-Step Verification ON
# 2. Security → App passwords → create one for "Mail"
# 3. Use that 16-character password as SMTP_PASS (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ahadke26@gmail.com
SMTP_PASS=your-16-char-app-password
